<?xml version="1.0" encoding="utf-8"?>
<!-- pill_bg for dark_text: light frosted glass, and a dark pill for focus so it still stands out. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F2111111" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#596EC1FF" />
            <stroke android:width="1.5dp" android:color="#FF6EC1FF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#D9FFFFFF" android:endColor="#B3FFFFFF" />
            <stroke android:width="1dp" android:color="#59FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
